# ===== 后端 API (apps/api) =====
NODE_ENV=development
PORT=3000

# MySQL 8 连接串（对应 docker-compose.yml 起的实例）
# 注意：Windows + Docker Desktop 下 localhost 可能解析到 IPv6 ::1 导致连不上，统一用 127.0.0.1
DATABASE_URL="mysql://blog:blog@127.0.0.1:3306/blog?connection_limit=10"

# JWT（生产务必替换为强随机值，且仅通过环境变量提供，禁止入仓）
JWT_SECRET="dev-change-me-access-secret"
JWT_REFRESH_SECRET="dev-change-me-refresh-secret"
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# CORS：前端开发服务器地址，多个用逗号分隔
CORS_ORIGINS="http://localhost:5173"

# 上传
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# 限流：每 IP/用户每分钟的全局上限（敏感接口另有更严格覆盖）
THROTTLE_LIMIT=300

# 反向代理层数：生产跑在 Nginx 之后保持 1（用于取到真实客户端 IP）；
# 直接对外暴露（无代理）时设为 0，否则客户端可伪造 X-Forwarded-For 绕过限流。
TRUST_PROXY=1

# refresh Cookie 是否带 Secure 标记：仅在 HTTPS 部署时为 true。
# HTTP 部署（如本地 docker compose 的 :8080）必须为 false，否则浏览器不回传 Cookie。
COOKIE_SECURE=false

# 说明：当前限流与浏览量防刷均为「单进程内存实现」，未接入 Redis。
# 多实例横向扩容时需替换为共享存储，届时再补充 REDIS_URL 配置。
