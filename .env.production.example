# 生产/部署环境变量样例
# 复制为 .env 后按需修改；.env 不入仓（见 .gitignore）。
# 使用 docker compose 部署时，这些变量会被 compose 自动读取并注入容器。

# 数据库（MySQL 容器）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-blog

# JWT 密钥：务必替换为随机长字符串（切勿沿用默认值）
JWT_SECRET=please-generate-a-long-random-secret
JWT_REFRESH_SECRET=please-generate-another-long-random-secret
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# 前端来源白名单（跨域带 Cookie 时必须具体域名，禁止 *）
CORS_ORIGINS=http://localhost:8080

# refresh Cookie 是否带 Secure 属性。
# true  = 仅通过 HTTPS 回传（对外部署且已启用 TLS 时必须为 true）
# false = 允许 HTTP（仅用于本地/内网纯 HTTP 演示）
COOKIE_SECURE=true

# 反向代理层数（Nginx 前置时保持 1，使限流取到真实客户端 IP）
TRUST_PROXY=1

# 上传
UPLOAD_DIR=/app/apps/api/uploads
MAX_UPLOAD_SIZE=5242880

# 全局限流（次/分钟，按用户或 IP）
THROTTLE_LIMIT=300
